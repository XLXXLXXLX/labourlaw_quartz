        <mxCell id="85gdT_rlqh2LijloIdZ--100" value="假出差/外派&lt;div&gt;真调岗的情况&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=LXGW WenKai;fontSize=24;" vertex="1" parent="85gdT_rlqh2LijloIdZ--111">
