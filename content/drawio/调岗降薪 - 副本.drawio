        <mxCell id="85gdT_rlqh2LijloIdZ--103" value="&lt;font face=&quot;LXGW WenKai&quot;&gt;&lt;span style=&quot;font-size: 24px; text-wrap: nowrap; background-color: rgb(255, 255, 255);&quot;&gt;要求公司明确出差/外派的&lt;/span&gt;&lt;/font&gt;&lt;div&gt;&lt;font face=&quot;LXGW WenKai&quot;&gt;&lt;span style=&quot;font-size: 24px; text-wrap: nowrap; background-color: rgb(255, 255, 255);&quot;&gt;具体工作内容和持续时间&lt;/span&gt;&lt;/font&gt;&lt;div&gt;&lt;font face=&quot;LXGW WenKai&quot;&gt;&lt;span style=&quot;font-size: 24px; text-wrap: nowrap; background-color: rgb(255, 255, 255);&quot;&gt;要求公司提供各种补贴&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;" style="whiteSpace=wrap;html=1;" vertex="1" parent="85gdT_rlqh2LijloIdZ--111">
          <mxGeometry x="284" y="613.5" width="290" height="105" as="geometry" />
        </mxCell>
        <mxCell id="85gdT_rlqh2LijloIdZ--104" value="&lt;span style=&quot;color: rgb(0, 0, 0); font-family: &amp;quot;LXGW WenKai&amp;quot;; font-size: 24px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: center; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(251, 251, 251); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; display: inline !important;&quot;&gt;注：若劳动者及其近亲、配偶均无当地户口\居住证，且居住时间较短，无条件拒绝调岗可能不被认可，因此建议接受调岗并明确要求各种补贴&lt;/span&gt;" style="text;whiteSpace=wrap;html=1;" vertex="1" parent="85gdT_rlqh2LijloIdZ--111">
          <mxGeometry x="675" y="613.5" width="400" height="140" as="geometry" />
        </mxCell>
        <mxCell id="85gdT_rlqh2LijloIdZ--106" value="" style="endArrow=classic;html=1;rounded=0;exitX=0.131;exitY=0.977;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1.009;entryY=0.095;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="85gdT_rlqh2LijloIdZ--111" source="85gdT_rlqh2LijloIdZ--38" target="85gdT_rlqh2LijloIdZ--60">
